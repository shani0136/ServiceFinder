rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── 1. Authentication & Role Helpers ─────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin authorization:
    // - Verified Project Administrator emails
    // - Server-assigned Custom Claims (request.auth.token.admin == true)
    // - Documents in /admins/{uid}
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'shani145@gmail.com' ||
        request.auth.token.email == 'shanisharma145@gmail.com' ||
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Provider check: identifies registered providers
    function isProvider() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'provider') ||
        exists(/databases/$(database)/documents/providers_draft/$(request.auth.uid))
      );
    }

    // ─── 2. Centralized Service & Location Catalog Validations ────────────────
    function isAllowedService(serviceName) {
      return serviceName in [
        'Electrician',
        'Plumber',
        'Carpenter',
        'Painter',
        'AC & Appliance Repair',
        'Refrigerator Repair',
        'Washing Machine Repair',
        'RO / Water Purifier Repair',
        'TV Repair',
        'Computer & Laptop Repair',
        'Mobile Repair',
        'Vehicle Mechanic',
        'Home Cleaning',
        'Pest Control'
      ];
    }

    function isAllowedLocation(locationName) {
      return locationName in [
        'Churchgate',
        'Marine Lines',
        'Charni Road',
        'Grant Road',
        'Mumbai Central',
        'Mahalaxmi',
        'Lower Parel',
        'Prabhadevi',
        'Dadar',
        'Matunga Road',
        'Mahim',
        'Bandra',
        'Khar',
        'Santacruz',
        'Vile Parle',
        'Andheri',
        'Jogeshwari',
        'Ram Mandir',
        'Goregaon',
        'Malad',
        'Kandivali',
        'Borivali',
        'Dahisar'
      ];
    }

    // ─── 3. Admins Collection: admins/{adminId} ──────────────────────────────
    // Accessible strictly by verified project administrators
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // ─── 4. Users Collection: users/{userId} ──────────────────────────────────
    match /users/{userId} {
      // User can read their own profile; admins can view user directory
      allow read: if isOwner(userId) || isAdmin();

      // On creation, users can only set role to 'customer' or 'provider' (NEVER 'admin')
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.role in ['customer', 'provider'];

      // User can update profile details, but CANNOT change their role or uid (NO PRIVILEGE ESCALATION)
      allow update: if (
        isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid'])
      ) || isAdmin();

      // Only admins can delete user records
      allow delete: if isAdmin();
    }

    // ─── 5. Providers Collection: providers/{providerId} ─────────────────────
    match /providers/{providerId} {
      // Read access:
      // - Admins can read all providers (pending, approved, suspended, rejected)
      // - Providers can read their own profile
      // - Customers and public can read approved providers in the directory
      allow read: if isAdmin()
        || isOwner(providerId)
        || (isAuthenticated() && resource.data.uid == request.auth.uid)
        || resource.data.status == 'approved';

      // Provider registration:
      // - Must be authenticated
      // - status MUST start as 'pending'
      // - verified MUST start as false
      // - rating and reviewCount cannot be forged
      // - primaryService and serviceArea MUST match official Mumbai catalog
      allow create: if (
        isAuthenticated()
        && (request.resource.data.uid == request.auth.uid || providerId == request.auth.uid)
        && request.resource.data.status == 'pending'
        && request.resource.data.verified == false
        && (!('adminVerified' in request.resource.data) || request.resource.data.adminVerified == false)
        && (request.resource.data.rating == null || request.resource.data.rating == 0)
        && (!('reviewCount' in request.resource.data) || request.resource.data.reviewCount == 0)
        && isAllowedService(request.resource.data.primaryService)
        && isAllowedLocation(request.resource.data.serviceArea)
      ) || isAdmin();

      // Provider updates:
      // - Providers can update their phone, bio, charges, and toggle 'available' (boolean)
      // - Providers CANNOT self-approve (cannot touch status, verified, rating, reviewCount)
      // - Admins can update any field (approving, rejecting, suspending)
      allow update: if (
        (isOwner(providerId) || (isAuthenticated() && resource.data.uid == request.auth.uid))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'status', 'verified', 'approvedAt', 'approvedBy', 'rating', 'reviewCount', 'adminVerified'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['available']) || request.resource.data.available is bool)
      ) || isAdmin();

      // Only admins can delete provider records
      allow delete: if isAdmin();
    }

    // ─── 6. Providers Draft Collection: providers_draft/{draftId} ────────────
    match /providers_draft/{draftId} {
      allow read, write: if isOwner(draftId) || isAdmin();
      allow delete: if isOwner(draftId) || isAdmin();
    }

    // ─── 7. Reviews Collection: reviews/{reviewId} ───────────────────────────
    match /reviews/{reviewId} {
      // Anyone can read community ratings & reviews
      allow read: if true;

      // Authenticated customers can submit genuine reviews (rating 1 to 5)
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5;

      // Reviews cannot be altered by users; only admins can moderate or delete
      allow update, delete: if isAdmin();
    }

    // ─── 8. Callback & Support Requests Collection: callback_requests/{requestId} ────
    match /callback_requests/{requestId} {
      // Anyone (customers, providers, or visitors) can submit a callback / support inquiry
      allow create: if true;

      // Admins can read all callback requests; creators can read their own
      allow read: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Only admins can update status (pending, in_progress, resolved) or delete
      allow update, delete: if isAdmin();
    }
  }
}
